@page "/file/{Id}"
@inherits IndexComponentBase

<PageTitle>@(_file?.FileName ?? "File") · Specarr</PageTitle>

<nav aria-label="breadcrumb" class="mb-2">
    <ol class="breadcrumb mb-0 small">
        <li class="breadcrumb-item"><a href="">Library</a></li>
        @if (_title != null)
        {
            <li class="breadcrumb-item"><a href="title/@_title.Id">@_title.NameWithYear</a></li>
        }
        <li class="breadcrumb-item active sv-file-name" aria-current="page">@(_file?.Place.EpisodeLabel ?? _file?.FileName ?? "File")</li>
    </ol>
</nav>

@if (_file == null)
{
    @if (Index.IsLoading)
    {
        <div class="text-center py-5"><span class="spinner-border" role="status"></span></div>
    }
    else
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>This file is not in the library any more. <a href="">Back to the library</a>.
        </div>
    }

    return;
}

<FileDetailsView File="_file" Others="_others"/>

@code {
    [Parameter] public string Id { get; set; } = "";

    private IndexedFile? _file;
    private TitleEntry? _title;
    private List<IndexedFile> _others = [];

    protected override void OnParametersSet()
    {
        _file = Index.FindFile(Id);
        Relate();
    }

    protected override void OnIndexUpdated()
    {
        // The first walk may finish while the page is open.
        if (_file == null && Index.FindFile(Id) is { } file)
        {
            _file = file;
            Relate();
        }
    }

    /// <summary>The title it belongs to, and the files to compare it with: the same episode first, then the other files of the title.</summary>
    private void Relate()
    {
        _title = _file == null ? null : Snapshot.TitleOf(_file);
        _others = _title == null || _file == null
            ? []
            : _title.Files.Where(f => f != _file)
                .OrderByDescending(f => f.Place.EpisodeLabel != null && f.Place.EpisodeLabel == _file.Place.EpisodeLabel)
                .ThenBy(f => f.Place.IsExtra)
                .ThenBy(f => f.Place.Season ?? int.MaxValue).ThenBy(f => f.Place.Episode ?? int.MaxValue)
                .ThenBy(f => f.FileName)
                .ToList();
    }
}
