{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Specarr": {
    "Libraries": [
      { "Name": "Movies", "Path": "/movies", "Kind": "Movies", "Categories": true },
      { "Name": "TV", "Path": "/tv", "Kind": "Series", "Categories": true }
    ],
    "DatabasePath": "/config/specarr.db",
    "RescanHours": 6,
    "ProbeConcurrency": 1,
    "DetectHdr10Plus": true,
    "ReadDolbyVision": true,
    "ReadMediaInfo": true
  }
}
